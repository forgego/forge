# Yarn configuration for faster installs
node-linker: node-modules
enable-global-cache: true
enable-mirror: true
enable-network: true
enable-strict-pnp: false

# Performance optimizations
prefer-offline: true
prefer-proxy: false
network-timeout: 60000

# Faster installs
yarn-path: .yarn/releases/yarn-1.22.22.cjs
